#!/bin/bash

# 1. Define your list of protected branches separated by spaces
PROTECTED_BRANCHES="default-config obsidian-no-config"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# 2. Check if the current branch is in the protected list
IS_PROTECTED=false
for BRANCH in $PROTECTED_BRANCHES; do
  if [ "$CURRENT_BRANCH" == "$BRANCH" ]; then
    IS_PROTECTED=true
    break
  fi
done

if [ "$IS_PROTECTED" = true ]; then
  if [ "$BYPASS_PROTECTION" != "true" ]; then
    echo "-------------------------------------------------------"
    echo "❌ ERROR: Merging into a protected branch ($CURRENT_BRANCH) is prohibited."
    
    # Identify the terminal for Windows 11 users
    if [[ -n "$PSModulePath" ]]; then
      # PowerShell detected
      echo "Detected Terminal: PowerShell"
      echo "To update intentionally, use:"
      echo "  \$env:BYPASS_PROTECTION='true'; git merge <branch> (POWERSHELL)"
    elif [[ "$TERM" == "xterm"* ]] || [[ -n "$BASH_VERSION" ]]; then
      # Git Bash / Mintty detected
      echo "Detected Terminal: Git Bash"
      echo "To update intentionally, use:"
      echo "  BYPASS_PROTECTION=true git merge <branch> (BASH)"
    else
      # Fallback for CMD or unknown
      echo "To update intentionally, set the BYPASS_PROTECTION=true environment variable."
      echo "  set BYPASS_PROTECTION=true && git merge <branch> (CMD)"
    fi
    echo "-------------------------------------------------------"
    exit 1
  fi
  echo "⚠️ Bypass detected: Allowing merge into $CURRENT_BRANCH..."
fi