# Ignore workspace state (highly recommended)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/backups/
.obsidian/cache/
.obsidian/indexed-*

# Ignore large plugin caches
.obsidian/plugins/*/*.log
.obsidian/plugins/*/data.json (optional: keep if you want settings to persist)

## Ignore obsidian-git plugin becuase - This prevents the plugin's own internal state (like its backup timer) from causing merge conflicts when you switch branches.
.obsidian/plugins/obsidian-git/*
!.obsidian/plugins/obsidian-git/data.json


# Do NOT ignore community-plugins.json or themes
# as these define your branch "identity"